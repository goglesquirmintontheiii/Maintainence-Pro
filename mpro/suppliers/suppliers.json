{
  "_comment": "Built-in supplier recognition (MP-084). Each entry: domains (matched with and without www. and any subdomain), id_patterns (regexes with a named group 'id', matched against the URL path, then path+query), id_label, product_url template ({id}), category. Organizations add their own suppliers in Settings > Supplier connections (SupplierSite rows) without code.",
  "suppliers": [
    {"key": "amazon", "name": "Amazon", "category": "General online", "domains": ["amazon.com", "amazon.ca", "amazon.co.uk", "amazon.de", "amazon.fr", "amazon.it", "amazon.es", "amazon.com.mx", "amazon.com.au", "amazon.co.jp", "amazon.in", "smile.amazon.com"],
     "id_patterns": ["/(?:dp|gp/product|gp/aw/d|exec/obidos/ASIN|o/ASIN)/(?P<id>[A-Z0-9]{10})(?:[/?]|$)", "[?&]asin=(?P<id>[A-Z0-9]{10})"],
     "id_label": "ASIN", "product_url": "https://www.amazon.com/dp/{id}", "connector": "amazon_creators"},
    {"key": "amazon_short", "name": "Amazon (short link)", "category": "General online", "domains": ["amzn.to", "a.co", "amzn.com"],
     "id_patterns": ["^/(?:dp/)?(?P<id>[A-Za-z0-9]{6,12})$"], "id_label": "Short link", "product_url": "", "needs_resolving": true, "resolves_to": "amazon"},
    {"key": "walmart_business", "name": "Walmart Business", "category": "General online", "domains": ["business.walmart.com", "walmart.com"],
     "id_patterns": ["/ip/(?:[^/]+/)?(?P<id>\\d{5,12})(?:[/?]|$)"], "id_label": "Item #", "product_url": "https://business.walmart.com/ip/{id}"},
    {"key": "grainger", "name": "Grainger", "category": "Industrial MRO", "domains": ["grainger.com", "grainger.ca"],
     "id_patterns": ["/product/(?:[^/?]+-)?(?P<id>[0-9A-Z]{4,8})(?:[/?]|$)"], "id_label": "Grainger item #", "product_url": "https://www.grainger.com/product/{id}", "connector": "punchout_cxml"},
    {"key": "mcmaster", "name": "McMaster-Carr", "category": "Industrial MRO", "domains": ["mcmaster.com"],
     "id_patterns": ["^/(?:mv\\d+/)?(?P<id>\\d{3,6}[A-Z]\\d{1,4}(?:-[A-Z0-9]+)?)(?:[/?]|$)"], "id_label": "McMaster part #", "product_url": "https://www.mcmaster.com/{id}", "connector": "mcmaster"},
    {"key": "zoro", "name": "Zoro", "category": "Industrial MRO", "domains": ["zoro.com"],
     "id_patterns": ["/i/(?P<id>G\\d{5,10})(?:[/?]|$)"], "id_label": "Zoro #", "product_url": "https://www.zoro.com/i/{id}/"},
    {"key": "fastenal", "name": "Fastenal", "category": "Industrial MRO", "domains": ["fastenal.com"],
     "id_patterns": ["[?&]sku=(?P<id>\\d{4,10})", "/product/details/(?P<id>\\d{4,10})"], "id_label": "Fastenal SKU", "product_url": "https://www.fastenal.com/product/details/{id}", "connector": "punchout_cxml"},
    {"key": "msc", "name": "MSC Industrial", "category": "Industrial MRO", "domains": ["mscdirect.com"],
     "id_patterns": ["/product/details/(?P<id>\\d{6,10})"], "id_label": "MSC #", "product_url": "https://www.mscdirect.com/product/details/{id}", "connector": "punchout_cxml"},
    {"key": "global_industrial", "name": "Global Industrial", "category": "Industrial MRO", "domains": ["globalindustrial.com"],
     "id_patterns": ["/p/(?:[^/?]+-)?(?P<id>[A-Z]?\\d{5,10}[A-Z]?)(?:[/?]|$)"], "id_label": "Item #", "product_url": "https://www.globalindustrial.com/p/{id}"},
    {"key": "motion", "name": "Motion", "category": "Industrial MRO", "domains": ["motion.com", "motionindustries.com"],
     "id_patterns": ["/products/sku/(?P<id>\\d{4,10})"], "id_label": "Motion item #", "product_url": "https://www.motion.com/products/sku/{id}"},
    {"key": "graybar", "name": "Graybar", "category": "Electrical", "domains": ["graybar.com"],
     "id_patterns": ["/p/(?P<id>\\d{6,12})(?:[/?]|$)"], "id_label": "Graybar #", "product_url": "https://www.graybar.com/p/{id}"},
    {"key": "ced", "name": "CED", "category": "Electrical", "domains": ["cedonline.com", "ced.com"],
     "id_patterns": ["/product/(?:[^/?]+/)*(?P<id>[A-Za-z0-9-]{4,30})(?:[/?]|$)"], "id_label": "Item #", "product_url": ""},
    {"key": "platt", "name": "Platt Electric Supply", "category": "Electrical", "domains": ["platt.com"],
     "id_patterns": ["/p/(?P<id>\\d{4,10})(?:[/?]|$)"], "id_label": "Platt #", "product_url": "https://www.platt.com/p/{id}"},
    {"key": "rexel", "name": "Rexel", "category": "Electrical", "domains": ["rexelusa.com", "rexel.com", "rexel.ca"],
     "id_patterns": ["/p/(?P<id>\\d{4,12})(?:[/?]|$)", "/products?/(?:[^/?]+/)*(?P<id>\\d{4,12})(?:[/?]|$)"], "id_label": "Rexel #", "product_url": "https://www.rexelusa.com/p/{id}"},
    {"key": "automationdirect", "name": "AutomationDirect", "category": "Electrical", "domains": ["automationdirect.com"],
     "id_patterns": ["/pn/(?P<id>[A-Za-z0-9._-]{2,40})(?:[/?]|$)", "[?&]itemcode=(?P<id>[A-Za-z0-9._-]{2,40})"], "id_label": "Part #", "product_url": "https://www.automationdirect.com/pn/{id}"},
    {"key": "digikey", "name": "Digi-Key", "category": "Electrical", "domains": ["digikey.com", "digikey.ca", "digikey.co.uk", "digikey.de"],
     "id_patterns": ["/product-detail/[^/]+/[^/]+/[^/]+/(?P<id>\\d{4,12})(?:[/?]|$)", "/products/detail/[^/]+/[^/]+/(?P<id>\\d{4,12})(?:[/?]|$)"], "id_label": "Digi-Key product #", "product_url": ""},
    {"key": "mouser", "name": "Mouser", "category": "Electrical", "domains": ["mouser.com", "mouser.ca", "mouser.co.uk", "mouser.de"],
     "id_patterns": ["/ProductDetail/(?:[^/?]+/)?(?P<id>[A-Za-z0-9._%+-]{2,60})(?:[/?]|$)"], "id_label": "Mouser #", "product_url": "https://www.mouser.com/ProductDetail/{id}"},
    {"key": "uline", "name": "Uline", "category": "Janitorial & facility", "domains": ["uline.com", "uline.ca", "uline.mx"],
     "id_patterns": ["/Product/Detail/(?P<id>[A-Z]{1,3}-?\\d{2,6}[A-Z]{0,4})(?:[/?]|$)"], "id_label": "Uline model #", "product_url": "https://www.uline.com/Product/Detail/{id}", "connector": "punchout_cxml"},
    {"key": "imperial_dade", "name": "Imperial Dade", "category": "Janitorial & facility", "domains": ["imperialdade.com"],
     "id_patterns": ["/p/(?P<id>[A-Za-z0-9-]{3,30})(?:[/?]|$)", "/products/(?P<id>[A-Za-z0-9-]{3,30})(?:[/?]|$)"], "id_label": "Item #", "product_url": ""},
    {"key": "waxie", "name": "WAXIE", "category": "Janitorial & facility", "domains": ["waxie.com"],
     "id_patterns": ["/p/(?:[^/?]+/)?(?P<id>\\d{3,10})(?:[/?]|$)", "/products?/(?:[^/?]+/)*(?P<id>\\d{3,10})(?:[/?]|$)"], "id_label": "Item #", "product_url": ""},
    {"key": "hd_supply", "name": "HD Supply", "category": "Janitorial & facility", "domains": ["hdsupplysolutions.com", "hdsupply.com"],
     "id_patterns": ["/p/(?:[^/?]+-)?p?(?P<id>\\d{5,12})(?:[/?]|$)"], "id_label": "Item #", "product_url": "https://hdsupplysolutions.com/p/{id}"},
    {"key": "home_depot_pro", "name": "Home Depot Pro", "category": "Janitorial & facility", "domains": ["homedepotpro.com"],
     "id_patterns": ["/p/(?:[^/?]+-)?p?(?P<id>\\d{5,12})(?:[/?]|$)"], "id_label": "Item #", "product_url": ""},
    {"key": "home_depot", "name": "The Home Depot", "category": "Home improvement", "domains": ["homedepot.com", "homedepot.ca"],
     "id_patterns": ["/p/(?:[^/?]+/)?(?P<id>\\d{9})(?:[/?]|$)"], "id_label": "Internet #", "product_url": "https://www.homedepot.com/p/{id}"},
    {"key": "lowes", "name": "Lowe's", "category": "Home improvement", "domains": ["lowes.com", "lowes.ca"],
     "id_patterns": ["/pd/(?:[^/?]+/)?(?P<id>\\d{6,12})(?:[/?]|$)"], "id_label": "Item #", "product_url": "https://www.lowes.com/pd/{id}"}
  ]
}
